+    /** Shows a random "<game>-<slot>" picture, cross-fading from the current one. */
+    void focusSlot(String slot) {
+        if (!focusMode || closed) return;
+        if (!active || loading) {
+            focusPending = slot;
+            return;
+        }
+        String wanted = random.nextInt(20) == 0 && hasSlot("raro") ? "raro" : slot;
+        String game = gameOf(displayed);
+        List<File> pool = new ArrayList<>();
+        List<File> sameGame = new ArrayList<>();
+        for (File file : files) {
+            String name = file.getName();
+            if (name.equals(displayed) || !slotOf(name).equals(wanted)) continue;
+            if (gameOf(name).equals(game)) sameGame.add(file); else pool.add(file);
+        }
+        if (pool.isEmpty()) pool = sameGame;
+        if (pool.isEmpty()) return;
+        File next = pool.get(random.nextInt(pool.size()));
